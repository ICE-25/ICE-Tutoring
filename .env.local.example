# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). .env.local is gitignored.
#
# Both values are safe to expose in the browser — the anon key is designed to be
# public, and row level security is what protects your data.
#
# NEVER put the service_role key or your database password in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Cloudflare Turnstile (bot protection on the enroll form) ---------------
# Create a widget at https://dash.cloudflare.com -> Turnstile -> Add site.
# Leave these unset during development: the code falls back to Cloudflare's
# official test keys, which always pass.
#
# The SITE key is public and ships in the browser.
# The SECRET key is server-only — it must NOT have a NEXT_PUBLIC_ prefix,
# and you should paste it in yourself rather than sharing it.

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
